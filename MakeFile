COVERAGE_FILE := coverage.out
COVERAGE_HTML := coverage.html

ifeq ($(OS),Windows_NT)
    RM_CMD = powershell -Command "Remove-Item -ErrorAction SilentlyContinue $(COVERAGE_FILE), $(COVERAGE_HTML)"
else
    RM_CMD = rm -f $(COVERAGE_FILE) $(COVERAGE_HTML)
endif

.PHONY: test test-race lint fmt cover clean

fmt:
	@echo "==> Formatting code..."
	go fmt ./...

lint:
	@echo "==> Running golangci-lint..."
	golangci-lint run ./...

test:
	@echo "==> Running tests..."
	go test -v ./...

test-race:
	@echo "==> Running tests with race detector..."
	go test -v -race ./...

cover:
	@echo "==> Running tests with coverage..."
	go test -v -coverprofile=$(COVERAGE_FILE) ./...
	go tool cover -func=$(COVERAGE_FILE)
	go tool cover -html=$(COVERAGE_FILE) -o $(COVERAGE_HTML)
	@echo "Coverage HTML report generated at: $(COVERAGE_HTML)"

clean:
	@echo "==> Cleaning up..."
	@$(RM_CMD)
